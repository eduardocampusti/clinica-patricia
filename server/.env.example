# Variáveis do servidor (/server) — arquivo PRÓPRIO, não reaproveita o
# VITE_SUPABASE_URL/.env do frontend. Copie para .env e preencha.

# URL do projeto Supabase (mesmo projeto do frontend — confirme o project ref
# em 00-BANCO-DE-DADOS-OFICIAL.md antes de preencher).
SUPABASE_URL=https://xftnkusbyqzyvzrovroj.supabase.co

# Chave pública "anon" (mesma natureza da usada no frontend — segura por RLS,
# NÃO é uma chave privilegiada). Nenhuma chave privilegiada (service_role) é
# usada nesta etapa — ver README.md.
SUPABASE_ANON_KEY=

# Porta do servidor Fastify.
PORT=3333

# Origem permitida por CORS (o app frontend em dev).
CORS_ORIGIN=http://localhost:5173
